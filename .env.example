# Use a development Neon branch, never production credentials locally.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
AUTH_SECRET=
APP_URL=http://localhost:3000
# Set the Resend API key to enable reset, verification and welcome emails.
# Verify acadence.janidudev.com in Resend; sender alone is allowed while setup is pending.
RESEND_API_KEY=
EMAIL_FROM="Acadence <hello@acadence.janidudev.com>"
# Optional; supply both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Copy branch endpoint, region and S3 credentials from Neon Connect > Storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=studyflow
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional AWS-compatible aliases for standalone S3 tools; use the same values.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
CRON_SECRET=
# Aven uses OpenAI's Responses API. Only the private API key is required for
# the default models below. Custom models require current USD prices per 1M tokens.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_PLANNING_MODEL=gpt-4.1-mini
OPENAI_CHAT_INPUT_PRICE=0.40
OPENAI_CHAT_OUTPUT_PRICE=1.60
OPENAI_PLANNING_INPUT_PRICE=0.40
OPENAI_PLANNING_OUTPUT_PRICE=1.60
# Shared app cap: $5/month. Zero daily/token values disable those limits.
AVEN_DAILY_BUDGET_USD=0
AVEN_MONTHLY_BUDGET_USD=5
AVEN_GLOBAL_MONTHLY_BUDGET_USD=5
AVEN_DAILY_TOKEN_LIMIT=0
AVEN_MONTHLY_TOKEN_LIMIT=0
# Optional browser push. Generate once: node scripts/generate-vapid.mjs
# The public key is exposed to the browser; the private key stays server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@acadence.janidudev.com
# Required for production LMS mutation limits; authentication uses database limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set production/preview in hosted environments; local defaults to development.
CACHE_NAMESPACE=
# Audit runner uses an already started production server only when explicitly set.
PLAYWRIGHT_EXTERNAL_SERVER=
# Optional tests; only point at an isolated disposable Neon branch.
TEST_DATABASE_URL=
TEST_DATABASE_ISOLATED=false
TEST_DATABASE_FIXTURES_ONLY=
# Seeder reads credentials from env; set the requested account here locally.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=Acadence
SEED_USER_ROLE=super_admin
